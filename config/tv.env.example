# Web TV player password. Copy this file to the private config directory
# (for example /etc/iptv-qa/tv.env or /etc/iptv-checker/tv.env) and set a
# real password. systemd loads it via EnvironmentFile; never commit real
# values or record them in documentation.
IPTV_TV_PASSWORD=change-me
# Optional comma-separated tokens enabling /tv/playlist.m3u and the racing
# relay for TV apps. Requires the channel library; empty disables the endpoints.
# IPTV_TV_TOKENS=
