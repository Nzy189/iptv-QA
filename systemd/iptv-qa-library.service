[Unit]
Description=IPTV channel library publication and private backup worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=iptv-qa
Group=iptv-qa
WorkingDirectory=/opt/iptv-QA
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/iptv-QA/obs-sdk
EnvironmentFile=-/etc/iptv-qa/obs.env
ExecStart=/usr/bin/python3 -m iptv_qa library worker --config /etc/iptv-qa/config.json
Restart=on-failure
RestartSec=10s
UMask=0077
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
