# systemd 219 fallback ONLY for a host configured to Asia/Shanghai.
# Do not apply on a host in another timezone.
[Unit]
Description=Scheduled IPTV quality checks (Asia/Shanghai legacy host example)

[Timer]
OnCalendar=Mon,Wed,Sun *-*-* 08:00:00
Persistent=true
AccuracySec=1min
Unit=iptv-qa.service

[Install]
WantedBy=timers.target
